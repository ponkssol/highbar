{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile",
    "watchPatterns": [
      "apps/api/**",
      "packages/**",
      "pnpm-lock.yaml",
      "package.json",
      "deploy/railway/**"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @hb/api mint-pool:refill --loop 30",
    "restartPolicyType": "ALWAYS"
  }
}
