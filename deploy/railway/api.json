{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK", "buildCommand": "pnpm install --frozen-lockfile", "watchPatterns": ["apps/api/**", "packages/**", "pnpm-lock.yaml", "package.json", "deploy/railway/**"] },
  "deploy": {
    "startCommand": "pnpm --filter @hb/api start",
    "preDeployCommand": ["pnpm --filter @hb/api db:migrate"],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
