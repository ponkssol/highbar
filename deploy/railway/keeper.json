{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK", "buildCommand": "pnpm install --frozen-lockfile", "watchPatterns": ["packages/**", "pnpm-lock.yaml", "package.json", "deploy/railway/**"] },
  "deploy": {
    "startCommand": "pnpm --filter @hb/onchain run keeper --loop 30",
    "restartPolicyType": "ALWAYS"
  }
}
