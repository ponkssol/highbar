{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK", "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @hb/web build", "watchPatterns": ["apps/web/**", "packages/shared/**", "pnpm-lock.yaml", "package.json", "deploy/railway/**"] },
  "deploy": {
    "startCommand": "pnpm --filter @hb/web exec next start -H 0.0.0.0 -p ${PORT:-3000}",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
