{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK", "buildCommand": "pnpm install --frozen-lockfile", "watchPatterns": ["apps/api/**", "packages/**", "pnpm-lock.yaml", "package.json", "deploy/railway/**"] },
  "deploy": {
    "startCommand": "pnpm --filter @hb/api jobs:epoch",
    "cronSchedule": "15 0 * * *",
    "restartPolicyType": "NEVER"
  }
}
