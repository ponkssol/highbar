# ===== highbar jobs (Railway cron services "jobs-epoch" dan "jobs-barsnap") — MAINNET =====
# Satu template untuk kedua service cron. Salin ke Railway > jobs-epoch (dan jobs-barsnap) > Variables > Raw Editor.
# Semua payout DRY-RUN dulu: tidak ada SOL yang dikirim sampai DRY_RUN=false + ALLOW_MAINNET=true diset manual.
NETWORK=mainnet
# RPC mainnet QuickNode (endpoint server, sama dengan api): https://<nama-endpoint>.solana-mainnet.quiknode.pro/<token>/
# Ambil dari QuickNode dashboard > Endpoints > Create endpoint (Solana Mainnet)
# Catatan QuickNode: plan harus mengizinkan getProgramAccounts (dipakai indexer + job $HIGHER barsnap/feeshare); rate limit per plan berlaku (cek dashboard > Usage).
# (RPC_WS_URL=wss://<nama-endpoint>.solana-mainnet.quiknode.pro/<token>/ belum dibaca kode; tidak perlu diisi)
RPC_URL=<FILL_ME>
# Railway Postgres yang sama dengan api
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Private key keypair platform (fee claimer + pembayar cashback/buyback), JSON array. Seal di Railway. JANGAN commit.
# HARUS beda dengan wallet referral (buyback Jupiter bisa menutup WSOL ATA referral).
PLATFORM_KEYPAIR_JSON=<FILL_ME>
# Wallet treasury penerima fee yang di-claim (alamat publik, sama dengan api)
TREASURY_PUBKEY=<FILL_ME>
# Wallet referral platform (alamat publik, sama dengan api) — dikecualikan dari cashback
REFERRAL_WALLET=<FILL_ME>
# ---- Token resmi ekosistem $HIGHER ----
# Wallet dev KHUSUS yang akan me-launch $HIGHER di platform. Biarkan KOSONG sampai wallet itu pasti (bukan <FILL_ME>);
# selama kosong: job hanya memberi peringatan, $HIGHER tidak dideteksi otomatis, dan launch dengan simbol HIGHER ditolak (403) untuk semua wallet.
OFFICIAL_TOKEN_CREATOR=
# Simbol token resmi (dibandingkan tanpa beda huruf besar/kecil). Launch PERTAMA oleh OFFICIAL_TOKEN_CREATOR dengan simbol ini otomatis jadi token resmi.
OFFICIAL_TOKEN_SYMBOL=HIGHER
# [OPSIONAL] Override manual mint $HIGHER (kosong = pakai hasil deteksi yang disimpan API di database). Isi sama dengan api.
BAR_MINT=
# 6 config DBC mainnet (sama dengan api)
CONFIG_STANDARD_OFF=<FILL_ME>
CONFIG_STANDARD_ON=<FILL_ME>
CONFIG_HIGHER_OFF=<FILL_ME>
CONFIG_HIGHER_ON=<FILL_ME>
CONFIG_MAX_OFF=<FILL_ME>
CONFIG_MAX_ON=<FILL_ME>

# ---- mode aman: dry-run ----
DRY_RUN=true
ALLOW_MAINNET=false
BAR_FEE_SHARE_LIVE=false

# ---- buyback $HIGHER via Jupiter (BELUM diverifikasi di mainnet) ----
BUYBACK_MODE=jupiter
JUPITER_API_URL=https://api.jup.ag/swap/v1
# API key Jupiter (portal.jup.ag). Kosong = endpoint publik dengan limit
JUPITER_API_KEY=<FILL_ME>
BUYBACK_MAX_ORDER_SOL=0.5
BUYBACK_MAX_ORDERS_PER_RUN=5
BUYBACK_ORDER_DELAY_MS=60000
BUYBACK_MAX_SLIPPAGE_BPS=100
BUYBACK_MAX_PRICE_IMPACT_BPS=100

# ---- cashback / referral / milestone ----
CASHBACK_MIN_PAYOUT_SOL=0.001
CASHBACK_BATCH=8
REFERRAL_REWARD_BPS=2000
REFERRAL_MIN_PAYOUT_SOL=0.001
REFERRAL_CAP_TO_OPS=true
REWARDS_PAYOUT_BATCH=8
MILESTONES=hold-1k-7d:1000:7:1,hold-5k-30d:5000:30:5
MILESTONE_MIN_SAMPLES_PER_DAY=12
MILESTONE_MAX_PAYOUT_PER_RUN_SOL=10
LP_REBATE_MIN_PAYOUT_SOL=0.01
BAR_FEE_SHARE_BPS=2000
BAR_REQUIRE_SNAPSHOTS=true
