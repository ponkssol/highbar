# ===== highbar web (Railway service "web", Next.js) — MAINNET =====
# Salin ke Railway > web > Variables > Raw Editor. NEXT_PUBLIC_* dibaca saat BUILD: setelah mengubahnya, redeploy.
# Mainnet build: wallet hanya ditawarkan jaringan Solana mainnet, link explorer tanpa ?cluster=devnet
NEXT_PUBLIC_NETWORK=mainnet
NODE_ENV=production
# URL internal API lewat private network Railway (service bernama "api"). Biarkan seperti ini kalau nama service = api
API_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
# Harus SAMA dengan PROXY_SHARED_SECRET di service api
PROXY_SHARED_SECRET=<FILL_ME>
# Domain web production (https), sama dengan SITE_URL di api
SITE_URL=<FILL_ME>
# RPC untuk BROWSER (terlihat publik!). Pakai API key Helius TERPISAH yang dibatasi ke domain web (Helius > API key > Access Control / allowed domains)
RPC_URL=<FILL_ME>
# Reown (WalletConnect) project ID dari https://cloud.reown.com — tambahkan domain web ke allowlist project
REOWN_PROJECT_ID=<FILL_ME>
