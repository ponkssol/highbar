# ===== highbar web (Railway service "web", Next.js) — MAINNET =====
# Salin ke Railway > web > Variables > Raw Editor. Semua variabel dibaca server saat runtime (tidak ada variabel build-time); cukup restart service setelah mengubahnya.
# Jaringan: wallet hanya ditawarkan Solana mainnet, link explorer tanpa ?cluster=devnet, pesan sign-in "Network: mainnet"
NETWORK=mainnet
NODE_ENV=production
# URL internal API lewat private network Railway (service bernama "api"). Biarkan seperti ini kalau nama service = api
API_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
# Harus SAMA dengan PROXY_SHARED_SECRET di service api
PROXY_SHARED_SECRET=<FILL_ME>
# Domain web production (https), sama dengan SITE_URL di api
SITE_URL=<FILL_ME>
# RPC untuk BROWSER (URL ini terlihat oleh semua pengunjung!). Pakai endpoint QuickNode TERPISAH dari endpoint server,
# dikunci ke domain web: QuickNode dashboard > Endpoints > (endpoint browser) > Security > Referrer/Domain whitelist = domain web.
# Format: https://<nama-endpoint-browser>.solana-mainnet.quiknode.pro/<token>/ . Rate limit per plan berlaku
# (Variabel ini bernama RPC_URL, dibaca server saat runtime lalu dikirim ke browser)
RPC_URL=<FILL_ME>
# Reown (WalletConnect) project ID dari https://cloud.reown.com — tambahkan domain web ke allowlist project
REOWN_PROJECT_ID=<FILL_ME>
