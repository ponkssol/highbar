# ===== highbar mint pool (Railway service "mint-pool") — MAINNET =====
# Menggiling (grind) alamat mint yang berakhiran "high" di worker thread dan menyimpannya terenkripsi di tabel mint_pool.
# Start command: pnpm --filter @hb/api mint-pool:refill --loop 30   (lihat deploy/railway/mint-pool.json)
# Salin ke Railway > mint-pool > Variables > Raw Editor. Ganti semua <FILL_ME>. Jangan commit file yang sudah diisi.
NETWORK=mainnet
NODE_ENV=production
# [WAJIB] Railway Postgres yang SAMA dengan service api
DATABASE_URL=${{Postgres.DATABASE_URL}}
PG_POOL_MAX=2
# [WAJIB] RPC mainnet (boleh sama dengan api). Dipakai untuk cek apakah mint yang reservasinya kadaluarsa sudah ada on-chain
RPC_URL=<FILL_ME>
# [WAJIB] Kunci enkripsi AES-256-GCM, 32 byte (hex 64 karakter atau base64). HARUS SAMA PERSIS dengan MINT_POOL_ENC_KEY di service api.
# Tandai "Seal" di Railway. JANGAN commit. Tanpa kunci valid service ini berhenti dengan error.
MINT_POOL_ENC_KEY=<FILL_ME>
# Target jumlah mint siap pakai. Default 50 (harus sama dengan api supaya log/monitoring konsisten)
MINT_POOL_MIN_AVAILABLE=50
# Sama dengan api (dipakai saat sweep reservasi kadaluarsa)
MINT_POOL_RESERVATION_MIN=10
# Jumlah worker thread. ISI SESUAI vCPU service ini (Railway: os.availableParallelism() bisa melihat CPU host, bukan limit container).
# Contoh: 2 vCPU -> 2. Satu thread ~20-25 ribu key/detik -> ~7-8 menit CPU per alamat "...high" (rata-rata 11,3 juta percobaan).
MINT_POOL_THREADS=2
# Catatan: VANITY_MINTS (on|fallback|off, default fallback) diatur di service api, bukan di sini. Dengan VANITY_MINTS=off
# service mint-pool tidak dibutuhkan (boleh dimatikan).
