# ===== highbar API (Railway service "api") — MAINNET =====
# Salin ke Railway > service api > Variables > Raw Editor. Ganti semua <FILL_ME>. Jangan commit file yang sudah diisi.
# Baris bertanda [WAJIB] harus diisi: kalau kosong, API menolak start di mainnet.
NETWORK=mainnet
# Production mode: error 5xx tidak menampilkan detail ke user
NODE_ENV=production
# [WAJIB] RPC mainnet berbayar, mis. https://mainnet.helius-rpc.com/?api-key=XXX (dashboard.helius.dev > API Keys). Jangan pakai api.mainnet-beta.solana.com
RPC_URL=<FILL_ME>
# [WAJIB] Railway Postgres: isi dengan referensi ${{Postgres.DATABASE_URL}} (atau salin dari service Postgres > Variables)
DATABASE_URL=${{Postgres.DATABASE_URL}}
PG_POOL_MAX=10
# Railway private networking: dengarkan di IPv4+IPv6 supaya web bisa akses lewat api.railway.internal
HOST=::
PORT=4000
# Railway edge = 1 hop proxy; IP user diambil dari X-Forwarded-For hop terakhir
TRUST_PROXY=1
# [WAJIB] Domain web production (https), mis. https://highbar.fun. Dipakai untuk URI metadata token
SITE_URL=<FILL_ME>
# [WAJIB] Origin web yang boleh akses API (pisahkan koma). Sama dengan SITE_URL; bukan localhost / *
CORS_ORIGIN=<FILL_ME>
# [WAJIB] Secret login SIWS, min 32 karakter acak. Buat di PC: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=<FILL_ME>
# Secret bersama web<->api (harus SAMA di service web). Buat dengan perintah yang sama seperti AUTH_SECRET
PROXY_SHARED_SECRET=<FILL_ME>
# Token admin untuk POST /reindex (header x-admin-token). Kosong = /reindex mati di mainnet
ADMIN_TOKEN=<FILL_ME>

# ---- wallet & mint (hanya PUBLIC KEY di service api; tidak ada private key di sini) ----
# [WAJIB] Wallet treasury (penerima fee yang di-claim). Satu wallet biasa untuk sekarang (alamat publik)
TREASURY_PUBKEY=<FILL_ME>
# [WAJIB] Wallet referral platform (alamat publik). Jangan dipakai trading/buyback; WSOL ATA-nya = akun referral
REFERRAL_WALLET=<FILL_ME>
# WSOL ATA dari REFERRAL_WALLET (lihat docs/MAINNET_CHECKLIST.md langkah 2). Kosong = dihitung otomatis dari REFERRAL_WALLET
PLATFORM_REFERRAL_TOKEN_ACCOUNT=<FILL_ME>
# Public key dari keypair platform (fee claimer / buyback / keeper). Hanya untuk cek startup; private key TIDAK di sini
PLATFORM_PUBKEY=<FILL_ME>
# [WAJIB] Mint $BAR asli di mainnet (alamat mint)
BAR_MINT=<FILL_ME>

# ---- 6 config DBC mainnet [WAJIB] (output dari: pnpm --filter @hb/onchain exec tsx src/createConfigs.ts --network mainnet --send ...) ----
CONFIG_STANDARD_OFF=<FILL_ME>
CONFIG_STANDARD_ON=<FILL_ME>
CONFIG_HIGHER_OFF=<FILL_ME>
CONFIG_HIGHER_ON=<FILL_ME>
CONFIG_MAX_OFF=<FILL_ME>
CONFIG_MAX_ON=<FILL_ME>

# ---- keamanan / rate limit (default aman; per IP per menit) ----
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_TX_PER_MIN=30
RATE_LIMIT_LAUNCH_PER_MIN=6
RATE_LIMIT_METADATA_PER_MIN=6
RATE_LIMIT_REFERRAL_PER_MIN=10
RATE_LIMIT_AUTH_PER_MIN=20
LAUNCHES_PER_CREATOR_PER_HOUR=5
LAUNCHES_PER_IP_PER_HOUR=20
LOG_LEVEL=info

# ---- indexer & harga ----
INDEX_INTERVAL_MS=30000
TRADES_PER_POOL=25
SOL_USD=150
SCORES_INTERVAL_MS=600000
SURVIVAL_MIN_RATIO=0.5

# ---- payout: API tidak mengirim transaksi payout. Tetap dry-run ----
DRY_RUN=true
ALLOW_MAINNET=false
BUYBACK_MODE=jupiter
# Kill switch: true = /tx/launch menolak launch baru (trading token lama tetap jalan). Untuk rollback cepat
LAUNCHES_PAUSED=false
