# ===== highbar API (Railway service "api") — MAINNET =====
# Salin ke Railway > service api > Variables > Raw Editor. Ganti semua <FILL_ME>. Jangan commit file yang sudah diisi.
# Baris bertanda [WAJIB] harus diisi: kalau kosong, API menolak start di mainnet.
NETWORK=mainnet
# Production mode: error 5xx tidak menampilkan detail ke user
NODE_ENV=production
# [WAJIB] RPC mainnet QuickNode (server), format https://<nama-endpoint>.solana-mainnet.quiknode.pro/<token>/
# Ambil dari QuickNode dashboard > Endpoints > Create endpoint (Solana Mainnet). Jangan pakai api.mainnet-beta.solana.com
# Catatan QuickNode: plan harus mengizinkan getProgramAccounts (dipakai indexer + job $HIGHER barsnap/feeshare); rate limit per plan berlaku (cek dashboard > Usage).
# (RPC_WS_URL=wss://<nama-endpoint>.solana-mainnet.quiknode.pro/<token>/ belum dibaca kode; tidak perlu diisi)
RPC_URL=<FILL_ME>
# [WAJIB] Railway Postgres: isi dengan referensi ${{Postgres.DATABASE_URL}} (atau salin dari service Postgres > Variables)
DATABASE_URL=${{Postgres.DATABASE_URL}}
PG_POOL_MAX=10
# Railway private networking: dengarkan di IPv4+IPv6 supaya web bisa akses lewat api.railway.internal
HOST=::
PORT=4000
# Railway edge = 1 hop proxy; IP user diambil dari X-Forwarded-For hop terakhir
TRUST_PROXY=1
# [WAJIB] Domain web production (https), mis. https://highbar.fun. Dipakai untuk URI metadata token
SITE_URL=<FILL_ME>
# [WAJIB] Origin web yang boleh akses API (pisahkan koma). Sama dengan SITE_URL; bukan localhost / *
CORS_ORIGIN=<FILL_ME>
# [WAJIB] Secret login SIWS, min 32 karakter acak. Buat di PC: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=<FILL_ME>
# Secret bersama web<->api (harus SAMA di service web). Buat dengan perintah yang sama seperti AUTH_SECRET
PROXY_SHARED_SECRET=<FILL_ME>
# Token admin untuk POST /reindex (header x-admin-token). Kosong = /reindex mati di mainnet
ADMIN_TOKEN=<FILL_ME>

# ---- wallet & mint (hanya PUBLIC KEY di service api; tidak ada private key di sini) ----
# [WAJIB] Wallet treasury (penerima fee yang di-claim). Satu wallet biasa untuk sekarang (alamat publik)
TREASURY_PUBKEY=<FILL_ME>
# [WAJIB] Wallet referral platform (alamat publik). Jangan dipakai trading/buyback; WSOL ATA-nya = akun referral
REFERRAL_WALLET=<FILL_ME>
# WSOL ATA dari REFERRAL_WALLET (lihat docs/MAINNET_CHECKLIST.md langkah 2). Kosong = dihitung otomatis dari REFERRAL_WALLET
PLATFORM_REFERRAL_TOKEN_ACCOUNT=<FILL_ME>
# Public key dari keypair platform (fee claimer / buyback / keeper). Hanya untuk cek startup; private key TIDAK di sini
PLATFORM_PUBKEY=<FILL_ME>
# [WAJIB] Wallet KHUSUS penerima tip protokol per transaksi lock token (alamat publik). Di mainnet TIDAK ada fallback:
# kosong / <FILL_ME> / bukan pubkey valid = API menolak start. Harus wallet tersendiri: BUKAN platform key (PLATFORM_PUBKEY),
# BUKAN TREASURY_PUBKEY, BUKAN REFERRAL_WALLET, BUKAN OFFICIAL_TOKEN_CREATOR, BUKAN wallet devnet 9TAV... (dicek saat startup)
LOCK_TIP_WALLET=DN6H7ksaFRQp9oyj2guFoHf7UzYXAni9jTNAmHjnhigh
# [WAJIB] Besar tip per transaksi lock dalam SOL (angka > 0, maks 0.1)
LOCK_TIP_SOL=0.005
# ---- Token resmi ekosistem $HIGHER ----
# Wallet dev KHUSUS yang akan me-launch $HIGHER di platform. Biarkan KOSONG sampai wallet itu pasti (bukan <FILL_ME>);
# selama kosong: server hanya memberi peringatan, $HIGHER tidak dideteksi otomatis, dan launch dengan simbol HIGHER ditolak (403) untuk semua wallet.
OFFICIAL_TOKEN_CREATOR=
# Simbol token resmi (dibandingkan tanpa beda huruf besar/kecil). Launch PERTAMA oleh OFFICIAL_TOKEN_CREATOR dengan simbol ini otomatis jadi token resmi.
OFFICIAL_TOKEN_SYMBOL=HIGHER
# [OPSIONAL] Override manual mint $HIGHER. Kosong = pakai mint yang terdeteksi otomatis (atau override admin). Kalau diisi, nilai ini yang menang.
BAR_MINT=

# ---- vanity mint pool: setiap token baru alamat mint-nya berakhiran "high" (service mint-pool menggiling, api membagikan) ----
# Mode mint: on | fallback | off. Default fallback.
#   on       = hanya mint "...high"; pool kosong -> launch ditolak (503 MINT_POOL_EMPTY).
#   fallback = pakai pool; kalau pool kosong / tidak tersedia (kunci kosong, tabel belum ada) -> mint acak biasa,
#              ditandai di log "[mint-pool] pool empty -> fallback random mint ..." dan di respons (vanity:false).
#   off      = selalu mint acak (seperti sebelum fitur vanity); pool dan MINT_POOL_ENC_KEY tidak dipakai.
# Nilai lain = API menolak start.
VANITY_MINTS=fallback
# [WAJIB] Kunci enkripsi AES-256-GCM untuk secret mint di tabel mint_pool: 32 byte acak, hex (64 karakter) atau base64.
# Buat di PC: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  Tandai "Seal" di Railway. JANGAN commit,
# JANGAN pernah taruh di service web / NEXT_PUBLIC_*. Nilainya HARUS SAMA di service api dan mint-pool.
# VANITY_MINTS=on: kosong / salah = API menolak start. fallback: kosong = hanya peringatan (launch pakai mint acak), salah format = menolak start. off: tidak perlu.
# Kalau kunci hilang/diganti, mint yang sudah tersimpan tidak bisa dipakai lagi (pool harus diisi ulang).
MINT_POOL_ENC_KEY=<FILL_ME>
# Target jumlah mint "...high" yang siap pakai (dijaga oleh service mint-pool). Default 50
MINT_POOL_MIN_AVAILABLE=50
# Menit sebuah mint dicadangkan untuk satu launch sebelum kadaluarsa. Mint yang kadaluarsa hanya kembali ke pool kalau
# akunnya TIDAK ada on-chain (cek RPC); kalau ada, ditandai used. Default 10
MINT_POOL_RESERVATION_MIN=10

# ---- 6 config DBC mainnet [WAJIB] (output dari: pnpm --filter @hb/onchain exec tsx src/createConfigs.ts --network mainnet --send ...) ----
CONFIG_STANDARD_OFF=<FILL_ME>
CONFIG_STANDARD_ON=<FILL_ME>
CONFIG_HIGHER_OFF=<FILL_ME>
CONFIG_HIGHER_ON=<FILL_ME>
CONFIG_MAX_OFF=<FILL_ME>
CONFIG_MAX_ON=<FILL_ME>

# ---- keamanan / rate limit (default aman; per IP per menit) ----
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_TX_PER_MIN=30
RATE_LIMIT_LAUNCH_PER_MIN=6
RATE_LIMIT_METADATA_PER_MIN=6
RATE_LIMIT_REFERRAL_PER_MIN=10
RATE_LIMIT_AUTH_PER_MIN=20
LAUNCHES_PER_CREATOR_PER_HOUR=5
LAUNCHES_PER_IP_PER_HOUR=20
LOG_LEVEL=info

# ---- indexer & harga ----
INDEX_INTERVAL_MS=30000
# Maks transaksi yang diproses per pool per poll; sisanya diproses tick berikutnya (tidak ada yang hilang)
TRADES_PER_POOL=25
# Polling adaptif (hemat kredit RPC). 1 = aktif (default); 0 = mode lama: semua pool dipoll tiap INDEX_INTERVAL_MS
INDEXER_ADAPTIVE=1
# Pool dianggap aktif (dipoll tiap INDEX_INTERVAL_MS) selama N menit setelah ada aktivitas on-chain terakhir. Default 15
INDEXER_ACTIVE_WINDOW_MIN=15
# Pool baru tetap "panas" (dipoll tiap tick) selama N menit pertama setelah launch. Default 10
INDEXER_NEW_POOL_HOT_MIN=10
# Pool idle: interval poll naik 2x per poll kosong sampai batas ini (ms). Default 600000 (10 menit)
INDEXER_IDLE_MAX_MS=600000
# Pool yang sudah migrasi ke DAMM v2: sweep DBC sesekali untuk tx telat (ms). Default 3600000 (1 jam); 0 = tidak pernah
INDEXER_MIGRATED_SWEEP_MS=3600000
# getSignaturesForAddress: ukuran halaman (maks 1000) dan maks halaman per poll. Default 1000 dan 10
INDEXER_SIG_PAGE=1000
INDEXER_SIG_MAX_PAGES=10
SOL_USD=150
SCORES_INTERVAL_MS=600000
SURVIVAL_MIN_RATIO=0.5

# Hari go-public (UTC, format YYYY-MM-DD), nilai SAMA di api dan jobs-epoch. Isi saat go-public, mis. 2026-11-01.
# Cashback hanya dihitung dan dibayar mulai hari ini (hari dry-run tidak pernah di-backfill, juga lewat --period). Fee claim dan
# treasury split sebelum tanggal ini tidak masuk backlog buyback, /burn dan /stats. Kosong = tidak ada cashback sama sekali
# (halaman cashback menampilkan 0 awaiting) dan tanpa filter tanggal di tempat lain. Buyback mode mock tidak pernah dihitung.
# Format salah = api / jobs menolak start.
GO_PUBLIC_DATE=

# ---- payout: API tidak mengirim transaksi payout. Tetap dry-run ----
DRY_RUN=true
ALLOW_MAINNET=false
BUYBACK_MODE=jupiter
# Kill switch: true = /tx/launch menolak launch baru (trading token lama tetap jalan). Untuk rollback cepat
LAUNCHES_PAUSED=false
