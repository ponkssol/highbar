# ===== highbar keeper (Railway service "keeper") — MAINNET =====
# Keeper memigrasi kurva yang sudah penuh ke DAMM v2. Salin ke Railway > keeper > Variables > Raw Editor.
NETWORK=mainnet
# RPC mainnet QuickNode (boleh endpoint server yang sama dengan api): https://<nama-endpoint>.solana-mainnet.quiknode.pro/<token>/
# Ambil dari QuickNode dashboard > Endpoints > Create endpoint (Solana Mainnet). Rate limit per plan berlaku
RPC_URL=<FILL_ME>
# Private key keypair platform: isi JSON array secret key (isi file keypair, [12,34,...]). Tandai "Seal" di Railway. JANGAN commit.
# Wallet ini (keeper payer, bukan kurva) bayar biaya migrasi DBC -> DAMM v2: terukur di mainnet ~0.024 SOL (0.0237) per migrasi
# 2-posisi (pool 0.0063 + 2 posisi + 2 mint NFT Token-2022 + 4 token account + fee tx). Isi saldo SOL secukupnya. Bukan wallet referral.
PLATFORM_KEYPAIR_JSON=<FILL_ME>
# 6 config DBC mainnet (sama persis dengan service api)
CONFIG_STANDARD_OFF=<FILL_ME>
CONFIG_STANDARD_ON=<FILL_ME>
CONFIG_HIGHER_OFF=<FILL_ME>
CONFIG_HIGHER_ON=<FILL_ME>
CONFIG_MAX_OFF=<FILL_ME>
CONFIG_MAX_ON=<FILL_ME>
# Mulai dry-run (hanya log). Setelah smoke test OK, ubah DRY_RUN=false DAN ALLOW_MAINNET=true di Railway (bukan di file ini)
DRY_RUN=true
ALLOW_MAINNET=false
# Interval keeper (detik). Start command Railway: "keeper --loop" (tanpa angka) -> pakai KEEPER_LOOP_SEC. Default 900 (15 menit).
# Urutan prioritas: "--loop N" di start command > KEEPER_LOOP_SEC > 900. Jangan tulis "--loop 30" di start command, itu menimpa variabel ini.
KEEPER_LOOP_SEC=900
# Jalur cepat: selama ada kurva >= KEEPER_HOT_PCT (0.9 = 90%) yang masih ada trade, atau migrasi live gagal/tertunda,
# pass berikutnya jalan setelah KEEPER_HOT_LOOP_SEC (default 30) -> kurva penuh tetap dimigrasi dalam ~30 detik
KEEPER_HOT_LOOP_SEC=30
KEEPER_HOT_PCT=0.9

# ---- Token resmi ekosistem $HIGHER ----
# Wallet dev KHUSUS yang akan me-launch $HIGHER di platform. Biarkan KOSONG sampai wallet itu pasti (bukan <FILL_ME>);
# (Service ini belum membaca variabel ini; disimpan sama dengan api supaya semua service konsisten.)
OFFICIAL_TOKEN_CREATOR=
# Simbol token resmi (dibandingkan tanpa beda huruf besar/kecil). Launch PERTAMA oleh OFFICIAL_TOKEN_CREATOR dengan simbol ini otomatis jadi token resmi.
OFFICIAL_TOKEN_SYMBOL=HIGHER
