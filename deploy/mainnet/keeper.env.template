# ===== highbar keeper (Railway service "keeper") — MAINNET =====
# Keeper memigrasi kurva yang sudah penuh ke DAMM v2. Salin ke Railway > keeper > Variables > Raw Editor.
NETWORK=mainnet
# RPC mainnet QuickNode (boleh endpoint server yang sama dengan api): https://<nama-endpoint>.solana-mainnet.quiknode.pro/<token>/
# Ambil dari QuickNode dashboard > Endpoints > Create endpoint (Solana Mainnet). Rate limit per plan berlaku
RPC_URL=<FILL_ME>
# Private key keypair platform: isi JSON array secret key (isi file keypair, [12,34,...]). Tandai "Seal" di Railway. JANGAN commit.
# Wallet ini bayar fee migrasi (~0.05 SOL per migrasi): isi saldo SOL secukupnya. Bukan wallet referral.
PLATFORM_KEYPAIR_JSON=<FILL_ME>
# 6 config DBC mainnet (sama persis dengan service api)
CONFIG_STANDARD_OFF=<FILL_ME>
CONFIG_STANDARD_ON=<FILL_ME>
CONFIG_HIGHER_OFF=<FILL_ME>
CONFIG_HIGHER_ON=<FILL_ME>
CONFIG_MAX_OFF=<FILL_ME>
CONFIG_MAX_ON=<FILL_ME>
# Mulai dry-run (hanya log). Setelah smoke test OK, ubah DRY_RUN=false DAN ALLOW_MAINNET=true di Railway (bukan di file ini)
DRY_RUN=true
ALLOW_MAINNET=false
