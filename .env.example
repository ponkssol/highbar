NETWORK=devnet
RPC_URL=https://api.devnet.solana.com
RPC_WS_URL=wss://api.devnet.solana.com
PLATFORM_KEYPAIR_PATH=./keys/platform.keypair.json
TREASURY_PUBKEY=
REFERRAL_ACCOUNT=
CONFIG_STANDARD_OFF=
CONFIG_STANDARD_ON=
CONFIG_HIGHER_OFF=
CONFIG_HIGHER_ON=
CONFIG_MAX_OFF=
CONFIG_MAX_ON=
DATABASE_URL=postgres://user:password@host:port/railway
PINATA_JWT=
BAR_MINT=
# Token resmi ekosistem $HIGHER: wallet dev khusus yang me-launch-nya (kosong = tidak ada deteksi otomatis, simbol HIGHER ditolak untuk semua wallet)
OFFICIAL_TOKEN_CREATOR=
# Simbol token resmi (tanpa beda huruf besar/kecil). BAR_MINT (kalau diisi) tetap menang sebagai override manual.
OFFICIAL_TOKEN_SYMBOL=HIGHER
# buyback & cashback jobs (details: apps/api/.env.example)
ALLOW_MAINNET=false
# keeper interval: `keeper --loop N` > KEEPER_LOOP_SEC (bare `--loop`) > 900 s; no --loop = single pass
# KEEPER_LOOP_SEC=900
# fast lane: next pass after KEEPER_HOT_LOOP_SEC while a curve >= KEEPER_HOT_PCT still trades or a live migration is pending
# KEEPER_HOT_LOOP_SEC=30
# KEEPER_HOT_PCT=0.9
BUYBACK_MODE=
BUYBACK_MAX_ORDER_SOL=1
BUYBACK_MAX_SLIPPAGE_BPS=100
BUYBACK_MAX_PRICE_IMPACT_BPS=100
JUPITER_API_KEY=
CASHBACK_MIN_PAYOUT_SOL=0.001
# createConfigs (packages/onchain): fee claimer / leftover receiver; mainnet: see docs/MAINNET_CHECKLIST.md step 4
FEE_CLAIMER_PUBKEY=
LEFTOVER_RECEIVER=
# PAYER_PUBKEY= (simulate without a keypair)
# PLATFORM_KEYPAIR_JSON= (Railway: secret key JSON array instead of a file)
