{
  "manifest_version": 3,
  "name": "highbar",
  "short_name": "highbar",
  "description": "Launch a coin on highbar from any tweet on x.com, with a local launch wallet.",
  "version": "0.4.0",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "highbar", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://pbs.twimg.com/*", "https://api-production-810c.up.railway.app/*", "https://highbar.capital/*", "https://frontend-api-v3.pump.fun/*", "https://cdn.dexscreener.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [{ "matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "commands": { "launch-tweet": { "suggested_key": { "default": "Alt+L" }, "description": "Launch the tweet under the mouse or in view" } },
  "web_accessible_resources": [{ "resources": ["fonts/*.woff2", "terminals/*.png", "icons/icon-32.png", "chart.html", "chart.js", "ca-popup.js"], "matches": ["https://x.com/*", "https://twitter.com/*"] }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://www.gmgn.cc https://www.geckoterminal.com" }
}
