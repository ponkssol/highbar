# highbar API (Postgres store; server-side only. Railway PgBouncer public URL, transaction mode)
PORT=4000
DEVNET_RPC=https://api.devnet.solana.com
CORS_ORIGIN=http://localhost:3000
INDEX_INTERVAL_MS=30000
# Max txs handled per pool per poll; the rest is a backlog picked up on the next tick (nothing is skipped). Default 100
TRADES_PER_POOL=100
# Max txs per tick across all pools (default 300; 0 = no cap): keeps a busy tick near INDEX_INTERVAL_MS so new pools are
# discovered on time. New pools / tokens go first in every tick and are never held back by it
# INDEXER_TICK_MAX_TXS=300
# POST /mint/confirm fast path: index a just-launched token at once (~1-3 s) instead of on the next tick. Verified on-chain (DBC init
# event, one of our configs); at most once per mint; global caps per minute / at once. FAST_INDEX=0 turns it off
# FAST_INDEX=1
# FAST_INDEX_PER_MIN=30
# FAST_INDEX_MAX_CONCURRENT=4
# ---- adaptive indexer polling (RPC credit saver, indexer/schedule.ts) ----
# 1 = on (default). 0 = legacy: every pool fetches signatures every INDEX_INTERVAL_MS
# INDEXER_ADAPTIVE=1
# A pool stays hot (polled every tick) for N minutes after its last on-chain activity (default 15)
# INDEXER_ACTIVE_WINDOW_MIN=15
# A brand-new pool stays hot for its first N minutes (default 10)
# INDEXER_NEW_POOL_HOT_MIN=10
# Idle pools: poll interval doubles per empty poll up to this cap in ms (default 600000 = 10 min)
# INDEXER_IDLE_MAX_MS=600000
# Migrated pools: rare DBC sweep for late txs, in ms (default 3600000 = 1 h; 0 = never)
# INDEXER_MIGRATED_SWEEP_MS=3600000
# getSignaturesForAddress page size (max 1000) and page budget per poll (defaults 1000 and 10)
# INDEXER_SIG_PAGE=1000
# INDEXER_SIG_MAX_PAGES=10
SOL_USD=150
# Referral wallet; its WSOL ATA is the referral token account (create it once; never trade from this wallet or the SDK closes its WSOL ATA)
REFERRAL_WALLET=87xbpDawHmNdmnWfZfXvLQyKbXhF2kck41NoPxTWB9sJ
PLATFORM_REFERRAL_TOKEN_ACCOUNT=AxKPDcziLpKrdxu63jpo8w5Fka8n3rV3YNpkwm3LtfbL
DRY_RUN=true
# Postgres (all API data + fee / cashback / buyback job tables)
DATABASE_URL=postgres://user:password@host:port/railway
PG_POOL_MAX=10

# ---- fee claimer / cashback / buyback & burn jobs (pnpm --filter @hb/api jobs:epoch [-- --live] [-- --loop 3600]) ----
# devnet | mainnet. The jobs check the RPC genesis hash against it; live mainnet sends also need ALLOW_MAINNET=true.
NETWORK=devnet
# ALLOW_MAINNET=false
# DRY_RUN=true above: jobs only simulate unless DRY_RUN=false or --live. Platform keypair: PLATFORM_KEYPAIR_PATH (default packages/onchain/keys/devnet.keypair.json)
# PLATFORM_KEYPAIR_PATH=
# Fee receiver for claimed partner fees (default: the platform keypair, which is the configs' feeClaimer). Cashback + buybacks are paid by the platform keypair.
TREASURY_PUBKEY=
# Optional manual $HIGHER mint override (wins over the detected official launch). devnet: pnpm --filter @hb/api bar:mock-mint creates a mock mint (platform keypair = mint authority)
BAR_MINT=
# Token resmi ekosistem $HIGHER: wallet dev khusus yang me-launch-nya (kosong = tidak ada deteksi otomatis, simbol HIGHER ditolak untuk semua wallet)
OFFICIAL_TOKEN_CREATOR=
# Simbol token resmi (tanpa beda huruf besar/kecil). BAR_MINT (kalau diisi) tetap menang sebagai override manual.
OFFICIAL_TOKEN_SYMBOL=HIGHER
# jupiter | mock (default: mock on devnet, jupiter on mainnet)
# BUYBACK_MODE=
BUYBACK_MAX_ORDER_SOL=1
BUYBACK_MAX_ORDERS_PER_RUN=5
BUYBACK_ORDER_DELAY_MS=60000
# SOL the buyback (platform) wallet always keeps for fees / rent; unpaid cashback, LP rebates and fee share are kept on top
BUYBACK_WALLET_RESERVE_SOL=0.05
BUYBACK_MAX_SLIPPAGE_BPS=100
BUYBACK_MAX_PRICE_IMPACT_BPS=100
# Mock buyback price (SOL per whole mock BAR) and optional SOL sink for the "spent" SOL (default: SOL stays with the platform keypair)
BAR_MOCK_PRICE_SOL=0.000001
# BAR_MOCK_SOL_SINK=
JUPITER_API_URL=https://api.jup.ag/swap/v1
# JUPITER_API_KEY=
CASHBACK_MIN_PAYOUT_SOL=0.001
CASHBACK_BATCH=8
# CASHBACK_EXCLUDE_WALLETS=comma,separated
# Go-public day (UTC YYYY-MM-DD), the same value on api + jobs-epoch. Cashback accrues and pays only from this day (dry-run days are
# never backfilled, not even with jobs:cashback --period). Fee claims / treasury splits before it are left out of the buyback backlog,
# /burn and /stats. Unset = no cashback accrues or pays (the cashback page shows zero awaiting, accrualStart null) and no date filter
# elsewhere. Mock buybacks never count in totals. A malformed value stops the api and jobs from starting.
# GO_PUBLIC_DATE=

# ---- step 8: highbar score / leaderboard ----
# score + holders + hourly snapshot refresh inside the API (0 = off; or run jobs:scores separately).
# Curve snapshots are DB only (every run); DAMM v2 prices (RPC, getMultipleAccounts 100 per call) once per hour,
# plus every run for a fresh migration whose DAMM pool is not known yet
SCORES_INTERVAL_MS=600000
# a graduated token 'survives' a day while its DAMM v2 mcap stays >= this x its mcap at migration
SURVIVAL_MIN_RATIO=0.5

# ---- $HIGHER utility (step 8; see BAR_UTILITY.md). All off without BAR_MINT. ----
# BAR_BALANCE_CACHE_MS=60000
# Max tier launches need MAX_TIER_MIN_BAR $HIGHER (default: on once $HIGHER exists: BAR_MINT or detected)
# BAR_GATE_MAX_TIER=true
# BAR_CASHBACK_BOOST=true
# Live cashback boost / fee share refuse current balances when a period has no jobs:barsnap snapshots (default true on mainnet)
# BAR_REQUIRE_SNAPSHOTS=false
# Holder fee share = this many bps of each period's ops share; payouts stay off until BAR_FEE_SHARE_LIVE=true (legal review)
BAR_FEE_SHARE_BPS=2000
BAR_FEE_SHARE_LIVE=false
# BAR_FEE_SHARE_EXCLUDE_WALLETS=comma,separated

# ---- step 8: user referral + milestone bonus (pnpm jobs:referral | jobs:milestone; dry-run unless --live / DRY_RUN=false) ----
# Referrers are funded ONLY from the referral wallet's swap-referral income (20% of Meteora's protocol fee, ~0.04% of volume), never the platform share.
# REFERRAL_REWARD_BPS = share of the income their referees' trades generated that is passed on (10000 = all, max 10000); split by referees' volume.
REFERRAL_REWARD_BPS=10000
REFERRAL_MIN_PAYOUT_SOL=0.001
# Payouts are signed by the referral wallet (it unwraps its WSOL income first). Without its key the job only dry-runs. Never commit the key.
# REFERRAL_KEYPAIR_PATH=/secure/path/referral.json   (or REFERRAL_KEYPAIR_JSON; must match REFERRAL_WALLET; devnet may reuse the platform key)
# Transfers per payout tx (referral + milestone), 1-10
REWARDS_PAYOUT_BATCH=8
# Milestones as id:mcapSol:days:rewardSol,... (lowest hourly DAMM v2 snapshot mcap >= mcapSol on N consecutive full UTC days after migration)
MILESTONES=hold-1k-7d:1000:7:1,hold-5k-30d:5000:30:5
# Days with fewer hourly snapshots (score job, SCORES_INTERVAL_MS) are skipped, neither counting nor breaking the streak
MILESTONE_MIN_SAMPLES_PER_DAY=12
# Max SOL paid in milestone bonuses per run (0 = no cap)
MILESTONE_MAX_PAYOUT_PER_RUN_SOL=10
# Creator LP rebate (jobs:lprebate, also inside jobs:epoch): pay a creator once their unpaid rebates reach this (SOL, >= 0.001); below it they carry over.
# The rebate rates themselves (LP_REBATE_BPS 6875 / 6875 / 7500) are fixed per tier in packages/shared, not configurable.
LP_REBATE_MIN_PAYOUT_SOL=0.01

# ---- hardening (step 9). Mainnet: the API refuses to start without the required vars (see docs/MAINNET_CHECKLIST.md, deploy/mainnet/api.env.template) ----
# REFERRAL_ACCOUNT= (alias of REFERRAL_WALLET)
# Mainnet DBC configs (override configs.<network>.json): CONFIG_STANDARD_OFF= CONFIG_STANDARD_ON= CONFIG_HIGHER_OFF= CONFIG_HIGHER_ON= CONFIG_MAX_OFF= CONFIG_MAX_ON=
# Platform key: PLATFORM_KEYPAIR_JSON (secret key JSON array, Railway sealed var) or PLATFORM_KEYPAIR_PATH; the api itself only needs PLATFORM_PUBKEY
# PLATFORM_PUBKEY=
# AUTH_SECRET=            # >= 32 random chars (required on mainnet)
# SITE_URL=http://localhost:3000
# PROXY_SHARED_SECRET=    # same value on web + api: lets the API rate-limit the real user IP behind the web proxy
# TRUST_PROXY=1           # Railway edge
# HOST=::                 # Railway private networking
# ADMIN_TOKEN=            # header x-admin-token for POST /reindex (mainnet: disabled when unset)
# LAUNCHES_PAUSED=false   # kill switch for /tx/launch
# RATE_LIMIT_GLOBAL_PER_MIN=300 RATE_LIMIT_TX_PER_MIN=30 RATE_LIMIT_LAUNCH_PER_MIN=6 RATE_LIMIT_METADATA_PER_MIN=6 RATE_LIMIT_REFERRAL_PER_MIN=10 RATE_LIMIT_AUTH_PER_MIN=20
# LAUNCHES_PER_CREATOR_PER_HOUR=5 LAUNCHES_PER_IP_PER_HOUR=20
# RATE_LIMIT_OFF=1        # devnet only
# CHECK_CHAIN=1           # devnet: also run the on-chain config check at startup; SKIP_CHAIN_CHECK=1 skips it
# LOG_LEVEL=info
# NODE_ENV=production
