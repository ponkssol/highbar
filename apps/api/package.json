{
  "name": "@hb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:import": "tsx scripts/importJson.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test src/**/*.test.ts",
    "jobs:fees": "tsx src/jobs/run.ts fees",
    "jobs:cashback": "tsx src/jobs/run.ts cashback",
    "jobs:buyback": "tsx src/jobs/run.ts buyback",
    "jobs:epoch": "tsx src/jobs/run.ts epoch",
    "jobs:autoclaim": "tsx src/jobs/run.ts autoclaim",
    "jobs:lprebate": "tsx src/jobs/run.ts lprebate",
    "bar:mock-mint": "tsx src/jobs/createMockBar.ts",
    "jobs:scores": "tsx src/jobs/scores.ts",
    "jobs:barsnap": "tsx src/jobs/run.ts barsnap",
    "jobs:feeshare": "tsx src/jobs/run.ts feeshare",
    "jobs:referral": "tsx src/jobs/runReferralMilestone.ts referral",
    "jobs:milestone": "tsx src/jobs/runReferralMilestone.ts milestone",
    "mint-pool:refill": "tsx src/jobs/mintPool.ts",
    "mint-pool:status": "tsx src/jobs/mintPool.ts --status"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@fastify/cors": "^10.0.1",
    "@hb/onchain": "workspace:*",
    "@hb/shared": "workspace:*",
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "^2.0.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "1.99.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.1.0",
    "pg": "^8.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/bn.js": "^5.2.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.23.15"
  }
}
