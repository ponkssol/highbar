# server-only; browser calls same-origin /hb-api/* which proxies here
API_URL=http://localhost:4000
# referral wallet is applied server-side by the API (PLATFORM_REFERRAL_TOKEN_ACCOUNT / configs.devnet.json)
REFERRAL_WALLET=
RPC_URL=https://api.devnet.solana.com
# devnet | mainnet (server env read at runtime: wallet cluster, explorer links, sign-in message)
NETWORK=devnet
# Reown AppKit project ID (server-only, passed to client via layout). get at https://cloud.reown.com
REOWN_PROJECT_ID=
# same value as the API's PROXY_SHARED_SECRET (forwards the real user IP for rate limits)
PROXY_SHARED_SECRET=
# public web origin (OG images / share links)
SITE_URL=http://localhost:3000
# Token resmi ekosistem $HIGHER: wallet dev khusus yang me-launch-nya (info saja; badge Official datang dari API)
OFFICIAL_TOKEN_CREATOR=
# Simbol token resmi (tanpa beda huruf besar/kecil). BAR_MINT (kalau diisi) tetap menang sebagai override manual.
OFFICIAL_TOKEN_SYMBOL=HIGHER
