# server-only; browser calls same-origin /hb-api/* which proxies here
API_URL=http://localhost:4000
# referral wallet is applied server-side by the API (PLATFORM_REFERRAL_TOKEN_ACCOUNT / configs.devnet.json)
REFERRAL_WALLET=
RPC_URL=https://api.devnet.solana.com
# devnet | mainnet (explorer link cluster; inlined at build)
NEXT_PUBLIC_NETWORK=devnet
# Reown AppKit project ID (server-only, passed to client via layout). get at https://cloud.reown.com
REOWN_PROJECT_ID=
# same value as the API's PROXY_SHARED_SECRET (forwards the real user IP for rate limits)
PROXY_SHARED_SECRET=
# public web origin (OG images / share links)
SITE_URL=http://localhost:3000
