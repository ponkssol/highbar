{
    "name":  "@hb/onchain",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "main":  "src/index.ts",
    "types":  "src/index.ts",
    "scripts":  {
                    "typecheck":  "tsc --noEmit -p .",
                    "configs:dry":  "tsx src/createConfigs.ts --dry-run",
                    "configs:create":  "tsx src/createConfigs.ts",
                    "launch":  "tsx src/launch.ts",
