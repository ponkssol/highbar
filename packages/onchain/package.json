                    "quote":  "tsx src/trade.ts buy --quote-only",
                    "keeper":  "tsx src/keeper.ts"
                },
    "dependencies":  {
                         "@coral-xyz/anchor":  "^0.32.1",
                         "@hb/shared":  "workspace:*",
                         "@meteora-ag/dynamic-bonding-curve-sdk":  "^2.0.0",
                         "@solana/web3.js":  "^1.99.0",
                         "bn.js":  "^5.2.5",
                         "dotenv":  "^18.0.9"
                     },
    "devDependencies":  {
                            "@types/bn.js":  "^5.2.0",
                            "tsx":  "^4.23.15"
                        }
}